# Obsidian local UI state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json

# Obsidian cache / trash
.obsidian/cache/
.trash/

# Community plugins are machine-specific for now.
.obsidian/community-plugins.json
# This also avoids syncing plugin data that may contain tokens.
.obsidian/plugins/

# Root-level unnamed Obsidian Bases drafts
/*.base

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
~$*

# Logs
*.log